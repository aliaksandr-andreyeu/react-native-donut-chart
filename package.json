{
  "name": "react-native-donut-chart",
  "version": "0.0.1",
  "description": "A simple SVG Circle donut chart",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write \"./**/*.{js,jsx,cjs,mjs,ts,tsx,json}\"",
    "postinstall": "typesync",
    "build": "tsc",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliaksandr-andreyeu/react-native-donut-chart.git"
  },
  "keywords": [
    "donut",
    "doughnut",
    "chart",
    "gaps",
    "react-native",
    "ios",
    "android"
  ],
  "author": "Aliaksandr Andreyeu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aliaksandr-andreyeu/react-native-donut-chart/issues"
  },
  "homepage": "https://github.com/aliaksandr-andreyeu/react-native-donut-chart#readme",
  "devDependencies": {
    "@eslint/js": "^8.0.0",
    "@types/eslint": "~9.6.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "19.2.14",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "react": "19.2.5",
    "react-native": "0.85.0",
    "react-native-svg": "15.15.4",
    "ts-jest": "^29.1.0",
    "typescript": "5.9.3",
    "typesync": "0.14.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  }
}
